    },
    "form": {
      "titles": {
        "add": "Add Leave Type",
        "edit": "Edit Leave Type {name}",
        "confirmBulk": "Confirm Bulk Leave Allocation"
      },
      "labels": {
        "name": "Name",
        "daysPerYear": "Days Per Year",
        "cycleMonths": "Cycle (Months)",
        "carryForwardMonths": "Carry Forward (Months)",
        "excludesSaturday": "Excludes Saturday",
        "excludesSunday": "Excludes Sunday",
        "applyToEmployees": "Apply To Employees",
        "gender": "Gender",
        "startDate": "Start Date"
      },
      "placeholders": {
        "name": "Leave Type Name",
        "daysPerYear": "Days Per Year",
        "cycleMonths": "Cycle (Months)",
        "carryForwardMonths": "Carry Forward (Months)"
      },
      "hints": {
        "cycleMonths": "Leave at 12 for a normal annual leave type — set to 36 for a leave type usable once every 3 years (e.g. Maternity). Changing this later reshapes every existing allocation for this type.",
        "carryForwardMonths": "Optional — how many months unused balance from one cycle can still be used into the next. Leave blank to disable carry forward.",
        "excludesSaturday": "On — Saturdays within the requested date range are not counted as leave days. Off — Saturdays count like any other day.",
        "excludesSunday": "On — Sundays within the requested date range are not counted as leave days (e.g. Annual Leave in a 5- or 6-day work week). Off — Sundays count like any other day (e.g. some Sick Leave policies).",
        "applyAll": "This will allocate leave days to all existing employees",
        "applyEditNone": "Changes above (e.g. Days Per Year) won't reach employees who already have this leave type unless you pick a scope here",
        "applyNewNone": "Select an option to bulk allocate leave days",
        "gender": "Optional — narrow the scope above to only male or female employees (e.g. Maternity)",
        "startDate": "Optional — overrides the automatic date (Jan 1 for annual types, today for longer cycles) for any newly-created allocations."
      },
      "options": {
        "excluded": "Excluded",
        "counted": "Counted as a leave day",
        "none": "None",
        "allEmployees": "All Employees",
        "activeContracts": "Employees With Active Contracts",
        "any": "Any",
        "female": "Female",
        "male": "Male"
      },
      "messages": {
        "addSuccess": "Success Adding Leave Type",
        "updateSuccess": "Leave Type update success"
      },
      "validation": {
        "nameRequired": "name is required",
        "nameMax": "The name cannot exceed 255 characters",
        "daysRequired": "days per year is required",
        "daysMin": "Days per year must be greater than 0",
        "cycleMin": "Cycle must be at least 1 month",
        "cycleMax": "Cycle cannot exceed 240 months",
        "carryMin": "Carry forward cannot be negative",
        "carryMax": "Carry forward cannot exceed 60 months"
      },
      "buttons": {
        "cancel": "Cancel",
        "submit": "Submit",
        "continue": "Continue"
      },
      "bulk": {
        "intro": "This action will allocate {days} leave days to multiple employees:",
        "willUpdate": "Will Update:",
        "employeesCount": "{count} employees",
        "updateNote": "(Employees who already have this leave type will have their allocation updated)",
        "willCreate": "Will Create:",
        "newEmployeesCount": "{count} new employees",
        "createNote": "(Employees who don't have this leave type will get it allocated)",
        "willSkip": "Will Skip (already mid-cycle):",
        "skipNote": "(Employees already partway through a multi-year cycle are left untouched — edit their allocation individually if you need to change it)",
        "warning": "This action cannot be undone. Continue?"
      }
    }
